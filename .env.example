# Aplicacion
NODE_ENV=development
PORT=3000
DISTRIBUCION_NAME=distribucion

# Redis: unico almacen de Distribucion (cuotas y scopes por socio).
# Segun el ADR este servicio no tiene base de datos relacional.
REDIS_URL=redis://localhost:6379

# Vault. Solo declarado: la lectura de secretos es parte del ASR de
# seguridad y todavia no esta integrada.
VAULT_ADDR=http://localhost:8200

# Microservicios vecinos. Nunca una IP ni un host escrito en el codigo
# (regla 4 de CLAUDE.md). Los puertos son los que publica el
# docker-compose.local.yml de cada repositorio.
IDENTIDAD_URL=http://localhost:3001
SUSCRIPCIONES_URL=http://localhost:3002
SINIESTROS_URL=http://localhost:3003
CATALOGO_URL=http://localhost:3004
COTIZACION_URL=http://localhost:3005
AUDITORIA_URL=http://localhost:3006

# Tope de espera por comando de Redis (ms). Si Redis se cae, nada se queda colgado.
REDIS_TIMEOUT_MS=500

# ---- ASR de escalabilidad (Ivonne): tacticas, se apagan sin cambiar la imagen ----
# Rate limit por socio (token bucket en Redis, compartido entre replicas).
RATE_LIMIT_ENABLED=true
# Cuota por defecto de cada socio: tokens por segundo y rafaga maxima.
# Un socio puede tener la suya: HSET cuota:<socioId> tps 50 rafaga 100
RATE_LIMIT_TPS=10
RATE_LIMIT_BURST=20
# Si Redis no responde: true = dejar pasar (prioriza disponibilidad), false = 503.
RATE_LIMIT_FAIL_OPEN=true

# Cache cache-aside de POST /clientes/verificacion de Identidad (TTL en segundos).
CACHE_ENABLED=true
CACHE_TTL_S=60

# Cada cuantos segundos cada replica escribe su linea de metricas en el log.
METRICAS_INTERVALO_S=10
